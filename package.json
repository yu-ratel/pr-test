{
  "name": "singletest",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "tokens:build": "style-dictionary build --config token.config.js",
    "lint": "eslint . --ext ts,tsx",
    "preview": "vite preview",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tools/**/*.{js,cjs,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"tools/**/*.{js,cjs,json,md}\""
  },
  "dependencies": {
    "@byuckchon-frontend/basic-ui": "^1.2.0",
    "@byuckchon-frontend/core": "^1.1.3",
    "@byuckchon-frontend/hooks": "^1.3.12",
    "@byuckchon-frontend/utils": "^1.5.0",
    "@tanstack/react-query": "^5.74.4",
    "axios": "^1.8.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.24.3",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.4",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "eslint": "^8.57.0",
    "eslint-config-expo": "^8.0.0",
    "eslint-import-resolver-typescript": "^3.6.0",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-react": "^7.34.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-unused-imports": "^4.1.4",
    "prettier": "^3.3.0",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "style-dictionary": "^5.4.0",
    "tailwindcss": "^4.1.4",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vite-plugin-svgr": "^4.3.0"
  }
}
