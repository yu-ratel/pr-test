{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "React Web (Vite)",
  "extends": "./base.json",
  "compilerOptions": {
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "moduleResolution": "Bundler",
    "module": "ESNext",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "useDefineForClassFields": true,
    "types": [
      "vite/client"
    ],
    "noUncheckedIndexedAccess": false
  }
}
